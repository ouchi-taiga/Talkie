{
	"name": "Talkie SvelteKit Dev Environment",
	"image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
	"runArgs": ["--name", "talkie-devcontainer", "--add-host", "host.docker.internal:host-gateway"],

	"features": {
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
	},

	// 認証情報・設定をコンテナ再作成後も保持する (このプロジェクト専用ボリューム)
	"mounts": ["source=claude-code-config-${devcontainerId},target=/home/node/.claude,type=volume"],

	// .claude.json (OAuth アカウント情報) もボリューム内に書き込ませる
	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "/home/node/.claude"
	},

	"shutdownAction": "stopContainer",
	"postCreateCommand": "sudo chown -R node:node /home/node/.claude",
	"waitFor": "postCreateCommand",

	"customizations": {
		"vscode": {
			"extensions": [
				"Anthropic.claude-code",
				"davidanson.vscode-markdownlint",
				"dbaeumer.vscode-eslint",
				"eamodio.gitlens",
				"esbenp.prettier-vscode",
				"mechatroner.rainbow-csv",
				"ms-vscode-remote.remote-containers",
				"tamasfe.even-better-toml",
				"svelte.svelte-vscode",
				"bradlc.vscode-tailwindcss"
			],
			"settings": {
				"editor.formatOnSave": true,
				"editor.defaultFormatter": "esbenp.prettier-vscode"
			}
		}
	},

	"remoteUser": "node"
}
